---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StepList from '../components/StepList.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import { areas, enfoques, pasos } from '../data/areas';
import { site, cityPhrase, withBase } from '../config/site';
---

<BaseLayout
  title={`Psicología infantil y adolescente${cityPhrase} | PsicoNido`}
  description={`Psicoterapia infantil y adolescente, evaluación y diagnóstico psicológico y orientación a padres. Atención presencial y online.`}
>
  <PageHero title="Acompañamiento para cada etapa de la vida" current="Áreas de atención" path="/areas-de-atencion/" image="/img/adolescentes-banner.jpg" side>
    Niñas, niños y adolescentes, de forma presencial u online.
  </PageHero>

  <section class="section">
    <div class="container areas">
      {
        areas.map((a, i) => (
          <article class="area" id={a.slug}>
            <header class="area__head">
              <span class="area__icon"><Icon name={a.icon} size={30} /></span>
              <h2>{a.title}</h2>
            </header>
            <img class="area__photo" src={withBase(a.image)} alt="" loading="lazy" width="1200" height="800" />
            <div class="area__body">
              <p class="lead">{a.long}</p>
              <ul class:list={["topics", { "topics--cols": a.topics.length > 6 }]}>
                {a.topics.map((t) => <li><Icon name="check" size={18} /> {t}</li>)}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--sand trama">
    <div class="container">
      <SectionHeading
        eyebrow="Modalidad"
        title="Presencial u online"
        lead="Elige la modalidad que mejor se adapte a ti y a tu familia."
      />
      <div class="grid grid--2">
        <div class="card mode">
          <span class="mode__icon"><Icon name="pin" size={26} /></span>
          <h3>Atención presencial</h3>
          <p>
            Un espacio cálido y reservado para conversar en persona.
            {site.address ? ` ${site.address}.` : ''}
          </p>
        </div>
        <div class="card mode">
          <span class="mode__icon"><Icon name="video" size={26} /></span>
          <h3>Atención online</h3>
          <p>Sesiones por videollamada, con la misma cercanía y confidencialidad, desde donde estés.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Enfoques"
        title="Formación en distintos enfoques terapéuticos"
        lead="Cada proceso se adapta a la historia, las necesidades y los tiempos de la persona."
      />
      <div class="grid grid--3">
        {
          enfoques.map((e) => (
            <div class="card">
              <h3>{e.title}</h3>
              <p class="muted">{e.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--cyan-100 trama trama--izq">
    <div class="container">
      <SectionHeading eyebrow="¿Cómo comenzar?" title="Agendar es simple" />
      <StepList steps={pasos} />
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .areas {
    display: grid;
    gap: 1.5rem;
  }
  .area {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 1.5rem 2rem;
    align-items: start;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow:
      0 1px 2px rgba(75, 63, 88, 0.04),
      0 22px 44px -28px rgba(75, 63, 88, 0.28);
    scroll-margin-top: 100px;
  }
  /* Zigzag: en las tarjetas pares la foto va a la derecha */
  .area:nth-child(even) {
    grid-template-columns: 1.2fr 0.8fr;
  }
  .area:nth-child(even) .area__photo {
    order: 2;
  }
  .area__head {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .area__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 0 14px 28px -18px rgba(75, 63, 88, 0.45);
  }
  .area .area__icon {
    background: linear-gradient(135deg, var(--cyan-100), var(--pink-soft));
  }
  .area__head h2 {
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    margin: 0;
  }
  .area__icon,
  .mode__icon {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 16px;
    background: var(--cyan-100);
    color: var(--navy-700);
  }
  .mode__icon {
    margin-bottom: 1rem;
  }
  .area .lead {
    margin-bottom: 1.25rem;
  }
  .topics {
    display: grid;
    gap: 0.65rem;
  }
  .topics--cols {
    display: block;
    columns: 2;
    column-gap: 2rem;
  }
  .topics--cols li {
    break-inside: avoid;
    margin-bottom: 0.65rem;
    line-height: 1.35;
  }
  @media (max-width: 640px) {
    .topics--cols {
      columns: 1;
    }
  }
  .topics li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-weight: 500;
  }
  .topics li :global(svg) {
    flex: none;
    margin-top: 0.22rem;
    color: var(--cyan-500);
  }
  .mode p,
  .muted {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 800px) {
    .area,
    .area:nth-child(even) {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .area:nth-child(even) .area__photo {
      order: 0;
    }
  }
</style>
