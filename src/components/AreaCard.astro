---
import Icon from './Icon.astro';
import { withBase } from '../config/site';

interface Props {
  icon: string;
  image?: string;
  title: string;
  text: string;
  href?: string;
}
const { icon, title, text, href, image } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="area" href={href}>
  {image && <img class="area__img" src={withBase(image)} alt="" loading="lazy" width="1200" height="800" />}
  <span class="area__icon"><Icon name={icon} size={28} /></span>
  <h3>{title}</h3>
  <p>{text}</p>
  {
    href && (
      <span class="area__more">
        Conocer más <Icon name="arrow" size={18} />
      </span>
    )
  }
</Tag>

<style>
  .area__img {
    width: calc(100% + 3.8rem);
    max-width: none;
    height: auto;
    margin: -1.9rem -1.9rem 1.4rem;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .area {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.9rem;
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  a.area:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    border-color: var(--cyan-300);
    color: var(--ink);
  }
  .area__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 1.25rem;
    border-radius: 16px;
    background: var(--cyan-100);
    color: var(--navy-700);
  }
  .area h3 {
    margin-bottom: 0.5rem;
  }
  .area p {
    margin-bottom: 1.25rem;
    color: var(--muted);
    font-size: 0.99rem;
  }
  .area__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--navy-700);
  }
</style>
