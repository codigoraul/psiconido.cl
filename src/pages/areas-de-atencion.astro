---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StepList from '../components/StepList.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import { areas, enfoques, pasos } from '../data/areas';
import { site, cityPhrase, withBase } from '../config/site';
---

<BaseLayout
  title={`Psicología infantil, adolescentes y adultos${cityPhrase} | PsicoNido`}
  description={`Psicoterapia infantil y adolescente, psicoterapia de adultos, evaluación y diagnóstico psicológico y orientación a padres. Atención presencial y online.`}
>
  <PageHero title="Acompañamiento para cada etapa de la vida" current="Áreas de atención" path="/areas-de-atencion/" image="/img/areas/evaluacion-diagnostico.jpg">
    Niños, adolescentes y adultos, de forma presencial u online.
  </PageHero>

  <section class="section">
    <div class="container areas">
      {
        areas.map((a, i) => (
          <article class="area" id={a.slug}>
            <div class="area__head">
              <span class="area__icon"><Icon name={a.icon} size={30} /></span>
              <h2>{a.title}</h2>
              <img class="area__photo" src={withBase(a.image)} alt="" loading="lazy" width="1200" height="800" />
            </div>
            <div class="area__body">
              <p class="lead">{a.long}</p>
              <ul class="topics">
                {a.topics.map((t) => <li><Icon name="check" size={18} /> {t}</li>)}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <SectionHeading
        eyebrow="Modalidad"
        title="Presencial u online"
        lead="Elige la modalidad que mejor se adapte a ti y a tu familia."
      />
      <div class="grid grid--2">
        <div class="card mode">
          <span class="mode__icon"><Icon name="pin" size={26} /></span>
          <h3>Atención presencial</h3>
          <p>
            Un espacio cálido y reservado para conversar en persona.
            {site.address ? ` ${site.address}.` : ''}
          </p>
        </div>
        <div class="card mode">
          <span class="mode__icon"><Icon name="video" size={26} /></span>
          <h3>Atención online</h3>
          <p>Sesiones por videollamada, con la misma cercanía y confidencialidad, desde donde estés.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Enfoques"
        title="Formación en distintos enfoques terapéuticos"
        lead="Cada proceso se adapta a la historia, las necesidades y los tiempos de la persona."
      />
      <div class="grid grid--3">
        {
          enfoques.map((e) => (
            <div class="card">
              <h3>{e.title}</h3>
              <p class="muted">{e.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--cyan-100">
    <div class="container">
      <SectionHeading eyebrow="¿Cómo comenzar?" title="Agendar es simple" />
      <StepList steps={pasos} />
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .areas {
    display: grid;
    gap: 1.5rem;
  }
  .area {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 2rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    scroll-margin-top: 100px;
  }
  .area__head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .area__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 16px;
  }
  .area__head h2 {
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    margin: 0;
  }
  .area__icon,
  .mode__icon {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 16px;
    background: var(--cyan-100);
    color: var(--navy-700);
  }
  .mode__icon {
    margin-bottom: 1rem;
  }
  .area .lead {
    margin-bottom: 1.25rem;
  }
  .topics {
    display: grid;
    gap: 0.65rem;
  }
  .topics li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-weight: 500;
  }
  .topics li :global(svg) {
    flex: none;
    margin-top: 0.22rem;
    color: var(--cyan-500);
  }
  .mode p,
  .muted {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 800px) {
    .area {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
