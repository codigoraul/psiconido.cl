---
import BookingButtons from './BookingButtons.astro';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Cada etapa de la vida merece ser escuchada, comprendida y acompañada.',
  text = 'Puedes agendar tu hora en Encuadrado o escribirme directamente por WhatsApp. La atención es presencial u online.',
} = Astro.props;
---

<section class="section cta">
  <div class="container">
    <div class="cta__card">
      <h2>{title}</h2>
      <p class="lead">{text}</p>
      <BookingButtons />
    </div>
  </div>
</section>

<style>
  .cta {
    background: #fff;
  }
  .cta__card {
    max-width: 920px;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 5vw, 4rem);
    text-align: center;
    background:
      radial-gradient(circle at 92% 10%, rgba(248, 166, 200, 0.3), transparent 45%),
      linear-gradient(120deg, #efebf4 0%, #f8f6fa 60%, #fff 100%);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 8px);
  }
  .cta__card h2 {
    max-width: 24ch;
    margin: 0 auto 0.6em;
  }
  .cta__card .lead {
    max-width: 56ch;
    margin: 0 auto;
  }
  .cta__card :global(.btn-row) {
    justify-content: center;
    margin-top: 1.75rem;
  }
</style>
