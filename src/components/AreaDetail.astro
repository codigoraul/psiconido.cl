---
import Icon from './Icon.astro';
import { withBase } from '../config/site';
import type { Area } from '../data/areas';

interface Props {
  area: Area;
  headingLevel?: 'h2' | 'h3';
}
const { area: a, headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
---

<article class="area" id={a.slug}>
  <header class="area__head">
    <span class="area__icon"><Icon name={a.icon} size={30} /></span>
    <H>{a.title}</H>
  </header>
  <img class="area__photo" src={withBase(a.image)} alt="" loading="lazy" width="1200" height="800" />
  <div class="area__body">
    <p class="lead">{a.long}</p>
    <ul class:list={['topics', { 'topics--cols': a.topics.length > 6 }]}>
      {a.topics.map((t) => <li><Icon name="check" size={18} /> {t}</li>)}
    </ul>
  </div>
</article>

<style>
  .area {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 1.5rem 2rem;
    align-items: start;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow:
      0 1px 2px rgba(75, 63, 88, 0.04),
      0 22px 44px -28px rgba(75, 63, 88, 0.28);
    scroll-margin-top: 100px;
  }
  /* Zigzag: en las tarjetas pares la foto va a la derecha */
  .area:nth-child(even) {
    grid-template-columns: 1.2fr 0.8fr;
  }
  .area:nth-child(even) .area__photo {
    order: 2;
  }
  .area__head {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .area__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 0 14px 28px -18px rgba(75, 63, 88, 0.45);
  }
  .area__icon {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--cyan-100), var(--pink-soft));
    color: var(--navy-700);
  }
  .area__head :is(h2, h3) {
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    margin: 0;
  }
  .area .lead {
    margin-bottom: 1.25rem;
  }
  .topics {
    display: grid;
    gap: 0.65rem;
  }
  .topics--cols {
    display: block;
    columns: 2;
    column-gap: 2rem;
  }
  .topics--cols li {
    break-inside: avoid;
    margin-bottom: 0.65rem;
    line-height: 1.35;
  }
  @media (max-width: 640px) {
    .topics--cols {
      columns: 1;
    }
  }
  .topics li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-weight: 500;
  }
  .topics li :global(svg) {
    flex: none;
    margin-top: 0.22rem;
    color: var(--cyan-500);
  }
  @media (max-width: 800px) {
    .area,
    .area:nth-child(even) {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .area:nth-child(even) .area__photo {
      order: 0;
    }
  }
</style>
