---
import BaseLayout from '../layouts/BaseLayout.astro';
import { cityPhrase, withBase } from '../config/site';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TeamCard from '../components/TeamCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import { team } from '../data/team';
import { formacion } from '../data/formacion';
import { enfoques } from '../data/areas';

const valores = [
  { icon: 'heart', title: 'Cercanía', text: 'Una atención cercana, que te hace sentir acompañado desde la primera conversación.' },
  { icon: 'shield', title: 'Confianza y respeto', text: 'Un espacio seguro y confidencial, basado en la confianza y el respeto.' },
  { icon: 'users', title: 'Atención personalizada', text: 'Cada historia es única: consideramos tus necesidades y tus tiempos.' },
];
---

<BaseLayout
  title={`Ps. Andrea Jara, psicóloga clínica${cityPhrase} | PsicoNido`}
  description={`Psicóloga clínica con formación en psicopatología infantojuvenil, terapia cognitivo-conductual, sistémica y DBT. Trabaja junto al psicólogo Fernando Palma.`}
>
  <PageHero title="Un equipo comprometido con tu bienestar" current="Nosotros" path="/nosotros/" image="/img/areas/orientacion-familias.jpg">
    Atención cercana, respetuosa y personalizada para cada persona.
  </PageHero>

  <section class="section">
    <div class="container intro">
      <div class="intro__photo">
        <img src={withBase('/equipo/andrea-sobre-mi.jpg')} alt="Ps. Andrea Jara Parada" width="572" height="572" />
      </div>
      <div class="intro__text">
        <p>
          Trabajo junto al psicólogo Fernando Palma, colega con más de 20 años de experiencia en la
          atención de adultos, cuya trayectoria enriquece cada proceso terapéutico.
        </p>
        <p>
          Juntos ofrecemos una atención cercana, profesional y personalizada, basada en la confianza,
          el respeto y la comprensión de cada persona, porque creemos que cada historia merece ser
          escuchada de manera única.
        </p>
        <p class="tagline">Psiconido: un espacio para escucharte, comprenderte y ayudarte a crecer.</p>
      </div>
    </div>
  </section>

  <section class="section section--cyan-100">
    <div class="container">
      <SectionHeading eyebrow="Profesionales" title="Quiénes te acompañan" />
      <div class="team">
        {team.map((m) => <TeamCard member={m} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Nuestra forma de trabajar" title="Lo que guía cada proceso" align="center" />
      <div class="grid grid--3">
        {
          valores.map((v) => (
            <div class="card value">
              <span class="value__icon"><Icon name={v.icon} size={26} /></span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <SectionHeading
        eyebrow="Enfoques terapéuticos"
        title="Herramientas para cada persona"
        lead="La formación de Andrea incluye distintos enfoques que se adaptan a la etapa y a las necesidades de cada paciente."
      />
      <div class="grid grid--3">
        {
          enfoques.map((e) => (
            <div class="card">
              <h3>{e.title}</h3>
              <p class="muted">{e.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Formación"
        title="Formación de Andrea Jara Parada"
        lead="Licenciada en Psicología Clínica, con formación continua en psicopatología infantojuvenil, vínculo, evaluación y adicciones."
      />
      <div class="grid grid--2">
        {
          formacion.map((g) => (
            <div class="card">
              <h3 class="group-title"><Icon name={g.icon} size={22} /> {g.title}</h3>
              <ul class="list">
                {g.items.map((i) => <li><Icon name="check" size={18} /> <span>{i}</span></li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .intro__photo {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--sand);
  }
  .intro__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 800px) {
    .intro {
      grid-template-columns: 1fr;
    }
    .intro__photo {
      max-width: 340px;
    }
  }
  .tagline {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--navy-700);
  }
  .team {
    display: grid;
    gap: 1.5rem;
  }
  .value__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 1rem;
    border-radius: 14px;
    background: var(--cyan-100);
    color: var(--navy-700);
  }
  .value p,
  .muted {
    margin: 0;
    color: var(--muted);
  }
  .group-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--navy-700);
  }
  .list {
    display: grid;
    gap: 0.75rem;
  }
  .list li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.98rem;
  }
  .list li :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--cyan-500);
  }
</style>
