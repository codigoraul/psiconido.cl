---
import Icon from './Icon.astro';
import { whatsappLink } from '../config/site';
---

<a
  class="wa"
  href={whatsappLink()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir por WhatsApp"
>
  <Icon name="chat" size={26} />
  <span>WhatsApp</span>
</a>

<style>
  .wa {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 1.2rem;
    border-radius: 999px;
    background: #1f7a52;
    color: var(--white);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.35);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .wa:hover {
    background: #17613f;
    color: var(--white);
    transform: translateY(-2px);
  }
  @media (max-width: 520px) {
    .wa span {
      display: none;
    }
    .wa {
      padding: 0.95rem;
    }
  }
</style>
