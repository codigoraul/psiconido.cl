---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappLink, cityPhrase } from '../config/site';
---

<BaseLayout
  title={`Agenda tu hora con una psicóloga${cityPhrase} | PsicoNido`}
  description={`Agenda tu hora de psicoterapia presencial u online por Encuadrado o WhatsApp con la Ps. Andrea Jara. Atención a niñas, niños, adolescentes y adultos.`}
>
  <PageHero title="Agenda tu hora" current="Contacto" path="/contacto/" image="/img/areas/adultos.jpg">
    Agenda en Encuadrado o escríbeme directamente por WhatsApp.
  </PageHero>

  <section class="section">
    <div class="container contact">
      <div class="contact__info">
        <ul class="channels">
          {
            site.encuadradoUrl && (
              <li>
                <a class="channel" href={site.encuadradoUrl} target="_blank" rel="noopener noreferrer">
                  <span class="channel__icon"><Icon name="calendar" size={24} /></span>
                  <span>
                    <strong>Agenda en Encuadrado</strong>
                    <small>Reserva tu hora online</small>
                  </span>
                </a>
              </li>
            )
          }
          <li>
            <a class="channel" href={whatsappLink()} target="_blank" rel="noopener noreferrer">
              <span class="channel__icon"><Icon name="chat" size={24} /></span>
              <span>
                <strong>WhatsApp directo con Andrea</strong>
                <small>{site.phoneDisplay}</small>
              </span>
            </a>
          </li>
          <li>
            <a class="channel" href={`mailto:${site.email}`}>
              <span class="channel__icon"><Icon name="mail" size={24} /></span>
              <span>
                <strong>Correo electrónico</strong>
                <small>{site.email}</small>
              </span>
            </a>
          </li>
          <li>
            <a class="channel" href={`tel:${site.phone}`}>
              <span class="channel__icon"><Icon name="phone" size={24} /></span>
              <span>
                <strong>Teléfono</strong>
                <small>{site.phoneDisplay}</small>
              </span>
            </a>
          </li>
        </ul>

        <div class="card modality">
          <h2>Modalidad de atención</h2>
          <ul>
            <li><Icon name="pin" size={20} /> <span>Presencial{site.address ? ` — ${site.address}` : ''}</span></li>
            <li><Icon name="video" size={20} /> <span>Online, por videollamada</span></li>
          </ul>
        </div>

        {
          site.mapEmbedUrl && (
            <div class="map">
              <iframe
                title={`Mapa de ubicación de ${site.name}`}
                src={site.mapEmbedUrl}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              />
            </div>
          )
        }
      </div>

      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .contact__info {
    display: grid;
    gap: 1.25rem;
  }
  .channels {
    display: grid;
    gap: 0.9rem;
  }
  .channel {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .channel:hover {
    transform: translateY(-2px);
    border-color: var(--cyan-300);
    box-shadow: var(--shadow);
    color: var(--ink);
  }
  .channel__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 14px;
    background: var(--cyan-100);
    color: var(--navy-700);
  }
  .channel strong,
  .channel small {
    display: block;
  }
  .channel small {
    color: var(--muted);
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }
  .modality h2 {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.9rem;
  }
  .modality ul {
    display: grid;
    gap: 0.6rem;
  }
  .modality li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .modality li :global(svg) {
    color: var(--cyan-500);
  }
  .map iframe {
    width: 100%;
    height: 280px;
    border: 0;
    border-radius: var(--radius);
  }
  @media (max-width: 900px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
