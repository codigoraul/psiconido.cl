---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StepList from '../components/StepList.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import AreaDetail from '../components/AreaDetail.astro';
import { areas, pasos } from '../data/areas';
import { site, cityPhrase, withBase } from '../config/site';
---

<BaseLayout
  title={`Psicología infantil y adolescente${cityPhrase} | PsicoNido`}
  description={`Psicoterapia infantil y adolescente, evaluación y diagnóstico psicológico y orientación a padres. Atención presencial y online.`}
>
  <PageHero title="Acompañamiento para cada etapa de la vida" current="Áreas de atención" path="/areas-de-atencion/" image="/img/adolescentes-banner.jpg" side>
    Niñas, niños y adolescentes, de forma presencial u online.
  </PageHero>

  <section class="section">
    <div class="container areas">
      {
        areas.map((a) => (
          <AreaDetail area={a} />
        ))
      }
    </div>
  </section>

  <section class="section section--sand trama">
    <div class="container">
      <SectionHeading
        eyebrow="Modalidad"
        title="Presencial u online"
        lead="Elige la modalidad que mejor se adapte a ti y a tu familia."
      />
      <div class="grid grid--2">
        <div class="card mode">
          <span class="mode__icon"><Icon name="pin" size={26} /></span>
          <h3>Atención presencial</h3>
          <p>
            Un espacio cálido y reservado para conversar en persona.
            {site.address ? ` ${site.address}.` : ''}
          </p>
        </div>
        <div class="card mode">
          <span class="mode__icon"><Icon name="video" size={26} /></span>
          <h3>Atención online</h3>
          <p>Sesiones por videollamada, con la misma cercanía y confidencialidad, desde donde estés.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cyan-100 trama trama--izq">
    <div class="container">
      <SectionHeading eyebrow="¿Cómo comenzar?" title="Agendar es simple" />
      <StepList steps={pasos} />
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .areas {
    display: grid;
    gap: 1.5rem;
  }
  .mode__icon {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    margin-bottom: 1rem;
    border-radius: 16px;
    background: var(--cyan-100);
    color: var(--navy-700);
  }
  .mode p,
  .muted {
    margin: 0;
    color: var(--muted);
  }
</style>
