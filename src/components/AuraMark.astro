---
interface Props {
  size?: number;
}
const { size = 44 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
>
  <circle cx="32" cy="32" r="5.5" fill="#F8A6C8"></circle>
  <circle cx="32" cy="32" r="14" stroke="#655570" stroke-width="3.4" stroke-linecap="round" pathLength="100" stroke-dasharray="74 26" transform="rotate(-70 32 32)"></circle>
  <circle cx="32" cy="32" r="22" stroke="#7950B3" stroke-width="3.4" stroke-linecap="round" pathLength="100" stroke-dasharray="68 32" transform="rotate(-10 32 32)"></circle>
  <circle cx="32" cy="32" r="29.5" stroke="#C9B2E8" stroke-width="3.4" stroke-linecap="round" pathLength="100" stroke-dasharray="58 42" transform="rotate(50 32 32)"></circle>
</svg>
